{
  "manifest_version": 3,
  "name": "ZenFocus Pro",
  "version": "1.1",
  "description": "Priority Task List, Site Blocker, and Tab Manager.",
  "permissions": [
    "storage", 
    "sidePanel", 
    "tabs", 
    "scripting", 
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open ZenFocus"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}