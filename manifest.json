{
  "manifest_version": 3,
  "name": "ZenFocus Pro",
  "version": "1.0",
  "description": "A deep-work suite with Reading Estimates and Site Blocking.",
  "permissions": ["storage", "sidePanel", "declarativeNetRequest", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open ZenFocus"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}